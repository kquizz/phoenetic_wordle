<%= turbo_stream.replace "row-#{@guess_index}" do %>
  <%= render "games/row", guess: @guess_data, row_index: @guess_index, phoneme_count: @game.phoneme_count %>
<% end %>

<%= turbo_stream.replace "error" do %>
  <%= render "games/error" %>
<% end %>

<% keyboard_states = phoneme_keyboard_states(@game) %>
<%= turbo_stream.replace "ipa-keyboard" do %>
  <div class="ipa-keyboard" id="ipa-keyboard">
    <% GamesHelper::IPA_KEYBOARD_LAYOUT.each do |section, phonemes| %>
      <div class="ipa-keyboard-section">
        <div class="ipa-keyboard-label"><%= section %></div>
        <div class="ipa-keyboard-row">
          <% phonemes.each do |phoneme| %>
            <% state = keyboard_states[phoneme] %>
            <button class="ipa-key <%= "ipa-key-#{state}" if state %>"
                    title="<%= ArpabetToIpa.friendly(phoneme) %>"
                    type="button">
              <span class="ipa-key-symbol"><%= phoneme %></span>
              <span class="ipa-key-hint"><%= ArpabetToIpa.friendly(phoneme).split("(").first.strip %></span>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<% if @game.over? %>
  <%= turbo_stream.replace "game-input" do %>
    <div class="game-over" id="game-input">
      <% if @game.won? %>
        <p class="result-message result-win">You got it in <%= @game.current_guess_number %>!</p>
      <% else %>
        <p class="result-message result-loss">
          The word was <strong><%= @game.target_word.text %></strong>
          (<span class="ipa">/<%= @game.target_word.ipa %>/</span>)
        </p>
      <% end %>
      <% if @game.daily_puzzle %>
        <button data-controller="share"
                data-share-text-value="<%= share_text(@game) %>"
                data-action="click->share#copy"
                class="btn btn-primary">
          Share Result
        </button>
      <% end %>
      <% unless @game.daily_puzzle %>
        <%= link_to "Play Again", practice_path(phonemes: @game.phoneme_count), class: "btn btn-primary" %>
      <% end %>
    </div>
  <% end %>
<% else %>
  <%= turbo_stream.replace "game-input" do %>
    <div class="input-row" id="game-input">
      <%= form_with url: game_guesses_path(@game), method: :post do |f| %>
        <%= f.text_field :guess,
             maxlength: 20,
             autocomplete: "off",
             autocapitalize: "none",
             placeholder: "Type a word...",
             class: "guess-input",
             autofocus: true %>
        <%= f.submit "Enter", class: "btn btn-submit" %>
      <% end %>
    </div>
  <% end %>
<% end %>
