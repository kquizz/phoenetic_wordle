<div id="error" class="error-container">
  <% if local_assigns[:message] %>
    <p class="error-message <%= 'hint-message' if local_assigns[:auto_dismiss] %>"
       <% if local_assigns[:auto_dismiss] %>data-controller="auto-dismiss" data-auto-dismiss-delay-value="4000"<% end %>>
      <%= message %>
    </p>
  <% end %>
</div>
